# Normalizacao de fim de linha entre Windows e Linux
# (o build no CI roda em ubuntu-latest)

# Scripts Unix devem permanecer com LF
mvnw    text eol=lf
*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Scripts Windows devem permanecer com CRLF
*.cmd   text eol=crlf
*.bat   text eol=crlf

# Binarios
*.jar   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.pdf   binary
*.zip   binary
